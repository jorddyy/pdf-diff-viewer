{
  "name": "pdf-diff-viewer",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Side-by-side diff viewer for LHCb ANA-Notes and paper drafts, running entirely in the browser",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:public": "vitest run --exclude 'examples/**'",
    "test:private": "vitest run examples",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "check-samples": "tsx scripts/check-samples.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:comments": "tsx scripts/e2e-comments.ts"
  },
  "dependencies": {
    "@pdfme/pdf-lib": "^6.2.2",
    "diff": "^9.0.0",
    "pdfjs-dist": "^6.3.289",
    "preact": "^11.0.0",
    "temml": "^0.14.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@puppeteer/browsers": "^3.2.3",
    "@types/node": "^26.6.4",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
